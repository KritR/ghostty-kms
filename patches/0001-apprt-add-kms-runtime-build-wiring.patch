diff --git a/src/build/SharedDeps.zig b/src/build/SharedDeps.zig
index 1f4143fcd..b86ac10e1 100644
--- a/src/build/SharedDeps.zig
+++ b/src/build/SharedDeps.zig
@@ -662,8 +662,8 @@ pub fn add(
             .flags = &.{},
         });
 
-        // Link EGL for GTK.
-        if (self.config.app_runtime == .gtk) {
+        // Link EGL for GTK and KMS.
+        if (self.config.app_runtime == .gtk or self.config.app_runtime == .kms) {
             step.root_module.addCSourceFile(.{
                 .file = b.path("vendor/glad/src/glad_egl.c"),
                 .flags = &.{},
@@ -691,6 +691,7 @@ pub fn add(
         switch (self.config.app_runtime) {
             .none => {},
             .gtk => try self.addGtkNg(step),
+            .kms => try @import("../apprt/kms/build.zig").add(b, step, dynamic_link_opts),
         }
     }
 
