From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Krithik <krithik@gradientrobotics.ai>
Date: Tue, 13 Oct 2026 16:41:49 -0700
Subject: [PATCH] apprt: add kms runtime (build wiring)

Adds the `kms` value to the app runtime enum, selects src/apprt/kms in
apprt.zig, links EGL for it, calls the kms build wiring in SharedDeps,
and adds .kms to the exhaustive app_runtime switches.

The runtime itself lives in src/apprt/kms, which is copied in from the
ghostty-raw-term repo and is not part of this patch.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/apprt.zig                 | 2 ++
 src/apprt/action.zig          | 2 +-
 src/apprt/runtime.zig         | 4 ++++
 src/apprt/structs.zig         | 4 ++--
 src/apprt/surface.zig         | 2 +-
 src/build/SharedDeps.zig      | 5 +++--
 src/config/Config.zig         | 6 +++---
 src/datastruct/split_tree.zig | 2 +-
 src/font/face.zig             | 2 +-
 src/input/Binding.zig         | 2 +-
 src/terminal/mouse.zig        | 2 +-
 11 files changed, 20 insertions(+), 13 deletions(-)

diff --git a/src/apprt.zig b/src/apprt.zig
index ef788c9bb..08c6fbe55 100644
--- a/src/apprt.zig
+++ b/src/apprt.zig
@@ -15,6 +15,7 @@ const structs = @import("apprt/structs.zig");
 pub const action = @import("apprt/action.zig");
 pub const ipc = @import("apprt/ipc.zig");
 pub const gtk = @import("apprt/gtk.zig");
+pub const kms = @import("apprt/kms/main.zig");
 pub const none = @import("apprt/none.zig");
 pub const browser = @import("apprt/browser.zig");
 pub const embedded = @import("apprt/embedded.zig");
@@ -44,6 +45,7 @@ pub const runtime = switch (build_config.artifact) {
     .exe => switch (build_config.app_runtime) {
         .none => none,
         .gtk => gtk,
+        .kms => kms,
     },
     .lib => embedded,
     .wasm_module => browser,
